# --- Supabase (required) -----------------------------------------------------
# Project URL: Supabase dashboard → Project Settings → API (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe for the browser. Local: `npx supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key — SERVER ONLY. Used solely for Auth admin calls
# (invite/create/ban users). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- App ---------------------------------------------------------------------
# Public base URL of the app; used in invite / password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: notification emails ------------------------------------------
# Shared secret for /api/cron/email-notifications (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# Resend API key and sender. If unset, notification emails are disabled (in-app still works).
RESEND_API_KEY=
EMAIL_FROM="Saunf <notifications@example.com>"
